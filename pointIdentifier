                center = dog[i+1,j+1,l+1,0]
                interestPoint = True
                for x in range(3):
                    for y in range(3):
                        for z in range(3):
                            if dog[i+x,j+y,l+z,0] > center:
                                interestPoint = False
                                break
                        if not interestPoint:
                            break
                    if not interestPoint:
                        break
                if interestPoint:
                    temp = np.array([[i+1,j+1,l+1]])

    shape = interestPoints.shape

    print(shape)

