import numpy as np
import cv2

def fieldIdentifier:
    video = cv2.VideoCapture("Soccer.mp4")
    success, source = video.read()

    gaussianSpace = np.array([source])

    k = 7
    for i in range(k):
        blur = pow(2,i+1) + 1
        gauss = cv2.GaussianBlur(source,(blur, blur),0)
        gauss = np.array([gauss])
        gaussianSpace = np.concatenate((gaussianSpace, gauss), axis=0)

    dog = np.array([np.subtract(gaussianSpace[1], gaussianSpace[0])])

    for i in range(1, k - 1):
        new = np.array([np.subtract(gaussianSpace[i + 1], gaussianSpace[i])])
        dog = np.concatenate((dog, new), axis=0)

    shape = dog.shape

    interestPoints = np.array([[0,0,0]])
    threshold = 200
    
    #TODO: send to gpu(perhaps entire function)
